\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Study design. The same harmful requests pass through four distribution shifts and are answered by 14 open-weight chat models. Each response is labelled as refused, complied, or other by a Qwen3-8B\xspace  judge, and checked by the \textsc  {HarmBench}\xspace  classifier (harmful completion) and an LLM-free string-match refusal detector. The \textsc  {ctrl}\xspace  rewrite in E1\xspace  and the \textsc  {XSTest}\xspace  safe prompts in E3\xspace  are the controls that separate keyword effects from paraphrase and meaning effects.\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Study design. The same harmful requests pass through four distribution shifts and are answered by 14 open-weight chat models. Each response is labelled as refused, complied, or other by a \judge judge, and checked by the \harmbench classifier (harmful completion) and an LLM-free string-match refusal detector. The \ctrl rewrite in \eone and the \xstest safe prompts in \ethree are the controls that separate keyword effects from paraphrase and meaning effects.\relax }{figure.caption.2}{}}
