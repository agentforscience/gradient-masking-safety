\citation{deng2024multilingual}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces E1\xspace  lexical ablation on the 178 items whose two rewrites were both judged meaning-preserving. Removing trigger words (\textsc  {kw-free}\xspace  ) lowers refusal significantly in 13 of 14 models, while a re-wording that keeps them (\textsc  {ctrl}\xspace  ) costs only 2.5\,pp\xspace  on average. $p$: exact McNemar test of \textsc  {ctrl}\xspace  vs.\xspace  \textsc  {kw-free}\xspace  , Holm-corrected across models; $^{\dagger }$ not significant at $\alpha =0.05$. The last column shows that the stricter \textsc  {HarmBench}\xspace  -harmful rate rises much less than refusal falls. Largest drops in {\bf  bold}.\relax }}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:e1}{{2}{7}{\eone lexical ablation on the 178 items whose two rewrites were both judged meaning-preserving. Removing trigger words (\kwfree ) lowers refusal significantly in 13 of 14 models, while a re-wording that keeps them (\ctrl ) costs only 2.5\pp on average. $p$: exact McNemar test of \ctrl \versus \kwfree , Holm-corrected across models; $^{\dagger }$ not significant at $\alpha =0.05$. The last column shows that the stricter \harmbench -harmful rate rises much less than refusal falls. Largest drops in {\bf bold}.\relax }{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces E2\xspace  multilingual results, averaged over the five non-English languages run for every model (zh, ar, bn, sw, jv; 315 prompts each). The last two columns are computed over prompts refused in English. Non-refusal overstates harmful compliance three- to ten-fold, because most non-refusals are off-topic, misunderstood, or garbled (``other''). $^{\ast }$Sub-3B models (H2). Largest bypass rates in {\bf  bold}.\relax }}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:e2}{{3}{7}{\etwo multilingual results, averaged over the five non-English languages run for every model (zh, ar, bn, sw, jv; 315 prompts each). The last two columns are computed over prompts refused in English. Non-refusal overstates harmful compliance three- to ten-fold, because most non-refusals are off-topic, misunderstood, or garbled (``other''). $^{\ast }$Sub-3B models (H2). Largest bypass rates in {\bf bold}.\relax }{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}E3\xspace  : refusal follows meaning, not keywords, at every size}{7}{subsection.4.3}\protected@file@percent }
\newlabel{sec:e3}{{4.3}{7}{\ethree : refusal follows meaning, not keywords, at every size}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces E3\xspace  : point-biserial correlation of refusal with trigger-word count (red), semantic harm rating (blue), and the LLM-free dataset harm label (purple), against model size, with 95\% bootstrap CIs. Dotted lines mark the hypothesised thresholds ($r_{\text  {kw}}>0.6$, $r_{\text  {harm}}<0.3$). The keyword correlation is at most 0.25 in every model and is always below the harm correlation.\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:e3}{{3}{8}{\ethree : point-biserial correlation of refusal with trigger-word count (red), semantic harm rating (blue), and the LLM-free dataset harm label (purple), against model size, with 95\% bootstrap CIs. Dotted lines mark the hypothesised thresholds ($r_{\text {kw}}>0.6$, $r_{\text {harm}}<0.3$). The keyword correlation is at most 0.25 in every model and is always below the harm correlation.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces E3\xspace  : what does refusal track? Left: point-biserial correlations of refusal with trigger-word count ($r_{\text  {kw}}$), semantic harm rating ($r_{\text  {harm}}$), and the LLM-free dataset label, on a pool of 1,615 prompts per model, with partial correlations of each predictor given the other. Right: lexicon-free contrasts in refusal rate (pp). The keyword effect holds meaning fixed (\textsc  {ctrl}\xspace  $-$\textsc  {kw-free}\xspace  ); the semantic effect holds trigger words fixed (\textsc  {XSTest}\xspace  unsafe $-$ safe). The larger of each pair is in {\bf  bold}: harm wins in every model, and no model shows the hypothesised keyword-matcher pattern ($r_{\text  {kw}}>0.6$, $r_{\text  {harm}}<0.3$).\relax }}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:e3}{{4}{8}{\ethree : what does refusal track? Left: point-biserial correlations of refusal with trigger-word count ($r_{\text {kw}}$), semantic harm rating ($r_{\text {harm}}$), and the LLM-free dataset label, on a pool of 1,615 prompts per model, with partial correlations of each predictor given the other. Right: lexicon-free contrasts in refusal rate (pp). The keyword effect holds meaning fixed (\ctrl $-$\kwfree ); the semantic effect holds trigger words fixed (\xstest unsafe $-$ safe). The larger of each pair is in {\bf bold}: harm wins in every model, and no model shows the hypothesised keyword-matcher pattern ($r_{\text {kw}}>0.6$, $r_{\text {harm}}<0.3$).\relax }{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces E4\xspace  : judge compliance with the 250 harmful requests asked directly (blue), in a fiction frame (orange), as the ``REX'' no-rules persona (brown), in an expert/hypothetical frame (pink), and through a three-turn escalation (red). Fiction breaks Qwen2.5-1.5B/3B/7B and Phi-3-mini; the persona breaks Llama-3.1-8B and Gemma-2-9B. Llama-2-7B-chat and Llama-3.2-1B/3B resist every framing. Vulnerability does not decrease with size.\relax }}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:e4}{{4}{9}{\efour : judge compliance with the 250 harmful requests asked directly (blue), in a fiction frame (orange), as the ``REX'' no-rules persona (brown), in an expert/hypothetical frame (pink), and through a three-turn escalation (red). Fiction breaks Qwen2.5-1.5B/3B/7B and Phi-3-mini; the persona breaks Llama-3.1-8B and Gemma-2-9B. Llama-2-7B-chat and Llama-3.2-1B/3B resist every framing. Vulnerability does not decrease with size.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces E4\xspace  : compliance with the 250 harmful requests under each framing. Left: the Qwen3-8B\xspace  judge (the reply carries out the request). Right: the stricter \textsc  {HarmBench}\xspace  classifier (the reply is a harmful completion). The two measures agree closely for the framing attacks, so the high fiction and persona rates are real harmful completions. For each model, the most effective framing is in {\bf  bold} when it reaches at least 20\%.\relax }}{9}{table.caption.10}\protected@file@percent }
\newlabel{tab:e4}{{5}{9}{\efour : compliance with the 250 harmful requests under each framing. Left: the \judge judge (the reply carries out the request). Right: the stricter \harmbench classifier (the reply is a harmful completion). The two measures agree closely for the framing attacks, so the high fiction and persona rates are real harmful completions. For each model, the most effective framing is in {\bf bold} when it reaches at least 20\%.\relax }{table.caption.10}{}}
